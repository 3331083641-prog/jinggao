# Optional local configuration; no credentials are needed.
# This file is documentation, not automatically loaded by the backend.
# Set these variables in the shell before starting the application.
# Relative paths are resolved from the process working directory.
JINGGAO_DATA_DIR=./backend/data
# Optional local OpenAI-style models. Empty = deterministic rules / OCR fallback.
# Only localhost or literal loopback IPs are accepted. No keys, redirects or cloud API.
JINGGAO_LOCAL_LLM_BASE_URL=
JINGGAO_LOCAL_LLM_MODEL=
# Optional: Ollama thinking models may need none for bounded JSON annotation.
# Empty preserves the original request; accepted: none / low / medium / high.
JINGGAO_LOCAL_LLM_REASONING_EFFORT=
JINGGAO_LOCAL_VISION_BASE_URL=
JINGGAO_LOCAL_VISION_MODEL=
